# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# workflow
.workflow/

# local sqlite data
/data/*.sqlite
/data/*.sqlite-*

# prisma
/src/generated/prisma

# The repository is public. Kept out of it on purpose:
# reference material that names the real enterprise behind the supply-chain scenario,
/content/
# the skill packages and walkthrough videos as delivered (the source for scripts/skills/prepare-backfill-media.sh),
/skill/
# and local review output.
/dogfood-output/
